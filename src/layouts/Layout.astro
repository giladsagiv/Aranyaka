---
import { defaultLang, dirs } from '../i18n/ui';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang={defaultLang} dir={dirs[defaultLang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  body {
    font-family: system-ui, sans-serif;
    background-color: #faf8f5;
    color: #1c1b1a;
    margin: 0;
    padding: 40px 20px;
  }
</style>
