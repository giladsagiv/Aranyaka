---
import { defaultLang, dirs } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const t = useTranslations();

const siteName = t('site.title');
const artistName = t('site.artist');
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const year = new Date().getFullYear();
const path = Astro.url.pathname;

const metaDescription = t('home.studioTagline');
const canonical = new URL(path, Astro.site).href;

// Same-origin static JPEG. WhatsApp's mobile scraper rejects the Sanity CDN
// URL (cross-origin, query string, a `.png` path serving JPEG bytes), so the
// preview image is served from public/og-image.jpg — a 1200x630 crop of the
// home artwork. Regenerate that file if the home image changes.
const ogImage = new URL('/og-image.jpg', Astro.site).href;
---
<!doctype html>
<html lang={defaultLang} dir={dirs[defaultLang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-name">{artistName}</span>
      </a>
      <nav class="site-nav">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>
          {t('nav.home')}
        </a>
        <a href="/gallery" aria-current={path.startsWith('/gallery') || path.startsWith('/artwork') ? 'page' : undefined}>
          {t('nav.gallery')}
        </a>
        <a href="/journal" aria-current={path.startsWith('/journal') ? 'page' : undefined}>
          {t('nav.journal')}
        </a>
        <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>
          {t('nav.about')}
        </a>
        <a href="/contact" aria-current={path.startsWith('/contact') ? 'page' : undefined}>
          {t('nav.contact')}
        </a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      © {year} {siteName}
    </footer>
  </body>
</html>
<style is:global>
  body {
    font-family: 'Open Sans', system-ui, sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.8;
    background-color: #ffffff;
    color: #696969;
    margin: 0;
    padding: 0 20px;
  }
  .site-header {
    text-align: center;
    padding: 56px 0 0;
  }
  .brand {
    display: inline-block;
    text-decoration: none;
  }
  .brand-name {
    display: block;
    font-size: clamp(22px, 5vw, 32px);
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1e1e1e;
    line-height: 1.1;
  }
  .site-nav {
    display: flex;
    justify-content: center;
    gap: 36px;
    margin: 28px 0 44px;
  }
  .site-nav a {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: #444;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease;
  }
  .site-nav a:hover { color: #1e1e1e; }
  .site-nav a[aria-current='page'] {
    color: #1e1e1e;
    border-bottom-color: #1e1e1e;
  }
  .site-footer {
    text-align: center;
    margin-top: 96px;
    padding: 40px 0;
    font-size: 13px;
    color: #9a9a9a;
  }
</style>
