---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/image';
import { useTranslations } from '../i18n/utils';
import type { Artwork, PrintsPage } from '../sanity/types';

const t = useTranslations();

const page: PrintsPage | null = await sanityClient.fetch(`
  *[_type == "printsPage"][0] {
    heading, intro,
    details[]{ label, text }
  }
`);

// grid = every artwork with "Fine Art Prints available" ticked, in gallery order
const prints = await sanityClient.fetch<Artwork[]>(`
  *[_type == "artwork" && printsAvailable == true] | order(orderRank) {
    title, image, altText, "slug": slug.current
  }
`);

const introParagraphs = (page?.intro || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---
<Layout title={t('nav.prints')}>
  <main>
    <header class="prints-intro">
      {page?.heading && <h1>{page.heading}</h1>}
      {introParagraphs.map((p) => <p>{p}</p>)}
    </header>

    <div class="prints-grid">
      {prints.map((art) => {
        const base = urlFor(art.image).auto('format');
        return (
          <article class="print">
            <a class="print__link" href={`/prints/${art.slug}`}>
              <div class="print__media">
                <img
                  src={base.width(600).url()}
                  srcset={`${base.width(400).url()} 400w,
                           ${base.width(600).url()} 600w,
                           ${base.width(800).url()} 800w`}
                  sizes="(max-width: 640px) 100vw,
                         (max-width: 1024px) 50vw, 33vw"
                  alt={art.altText}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h2 class="print__title">{art.title}</h2>
            </a>
          </article>
        );
      })}
    </div>

    {page?.details && page.details.length > 0 && (
      <details class="details">
        <summary class="details__heading">{t('prints.detailsHeading')}</summary>
        <dl class="details__list">
          {page.details.map((d) => (
            <div class="details__row">
              <dt>{d.label}</dt>
              {d.text && <dd>{d.text}</dd>}
            </div>
          ))}
        </dl>
      </details>
    )}
  </main>
</Layout>
<style>
  main { max-width: 1080px; margin: 0 auto; }

  /* header */
  .prints-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 64px;
  }
  .prints-intro h1 {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1e1e1e;
    margin: 0 0 24px;
  }
  .prints-intro p {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
    letter-spacing: 0.02em;
    color: #5a5a5a;
    margin: 0 0 1em;
  }
  .prints-intro p:last-child { margin-bottom: 0; }

  /* grid of print tiles */
  .prints-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 56px 28px;
  }
  .print { text-align: center; }
  .print__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .print__media img {
    width: 100%;
    height: auto;
    display: block;
    background-color: #f4f4f4;
    transition: opacity 0.2s ease;
  }
  .print__link:hover .print__media img { opacity: 0.9; }
  .print__title {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
    color: #1e1e1e;
    margin: 18px 0 0;
  }

  /* details & shipping — cream bands split by thin white lines */
  .details {
    max-width: 880px;
    margin: 96px auto 0;
    background-color: #ffffff;
  }
  .details__heading {
    position: relative;
    text-align: center;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1e1e1e;
    margin: 0;
    padding: 34px 28px;
    background-color: #faf9f7;
    cursor: pointer;
    list-style: none;
  }
  .details__heading::-webkit-details-marker { display: none; }
  .details__heading::after {
    content: '+';
    position: absolute;
    right: 26px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 15px;
    line-height: 1;
    color: #1e1e1e;
  }
  .details[open] .details__heading::after { content: '\2212'; }
  .details__list {
    margin: 4px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  /* the explicit display:grid above overrides the native collapse, so
     re-hide the panel when the accordion is closed */
  .details:not([open]) .details__list { display: none; }
  .details__row {
    margin: 0;
    padding: 28px 20px;
    background-color: #faf9f7;
  }
  .details__row dt {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1e1e1e;
    margin: 0 0 4px;
  }
  .details__row dd {
    margin: 0;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: #5a5a5a;
  }

  @media (max-width: 760px) {
    .details__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .details__list { grid-template-columns: 1fr; }
  }
</style>
