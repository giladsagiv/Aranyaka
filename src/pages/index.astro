---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/image';
import { useTranslations } from '../i18n/utils';
import type { HomePage } from '../sanity/types';

const t = useTranslations();

const home: HomePage | null = await sanityClient.fetch(`
  *[_type == "homePage"][0] { artistName, studioName, studioTagline, homeImage }
`);
---
<Layout title={home?.artistName}>
  <main class:list={['hero', { 'has-image': !!home?.homeImage }]}>
    {home?.homeImage && (
      <img
        class="hero-image"
        src={urlFor(home.homeImage).width(900).auto('format').url()}
        srcset={`${urlFor(home.homeImage).width(600).auto('format').url()} 600w,
                 ${urlFor(home.homeImage).width(900).auto('format').url()} 900w,
                 ${urlFor(home.homeImage).width(1200).auto('format').url()} 1200w`}
        sizes="(max-width: 768px) 100vw, 50vw"
        alt={home.homeImage.altText || home?.artistName || ''}
        decoding="async"
      />
    )}
    <div class="intro">
      {home?.artistName && <h1 class="sr-only">{home.artistName}</h1>}
      <p class="studio-label">{home?.studioName || t('home.studio')}</p>
      <p class="studio-tagline">{home?.studioTagline || t('home.studioTagline')}</p>
    </div>
  </main>
</Layout>
<style is:global>
  /* home page fits the viewport: footer sits at the bottom, no scrolling */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* outranks the layout's own .site-footer rule */
  body > .site-footer {
    margin-top: auto;
    padding: 24px 0;
  }
</style>
<style>
  .hero {
    text-align: center;
    padding-top: 16vh;
  }
  .hero.has-image {
    max-width: 1080px;
    width: 100%;
    margin: 0 auto;
    padding-top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .studio-label {
    margin: 0;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #555;
  }
  .studio-tagline {
    max-width: 620px;
    margin: 12px auto 0;
    font-size: 21px;
    font-style: italic;
    line-height: 1.6;
    color: #2b2b2b;
  }
  .hero-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 62.5%; /* 25% larger than the previous 50% */
    /* keeps the whole page inside one screen; shrinks with the window */
    max-height: calc((100vh - 280px) * 0.625);
    background-color: #f4f4f4;
  }
  @media (max-width: 768px) {
    .hero.has-image { gap: 28px; }
    .hero-image {
      max-width: 100%;
      max-height: 45vh;
    }
  }
</style>
