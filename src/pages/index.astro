---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/image';
import type { AboutPage } from '../sanity/types';

const about: AboutPage | null = await sanityClient.fetch(`
  *[_type == "aboutPage"][0] { artistName, tagline, homeImage }
`);
---
<Layout title={about?.artistName}>
  <main class:list={['hero', { 'has-image': !!about?.homeImage }]}>
    {about?.homeImage && (
      <img
        class="hero-image"
        src={urlFor(about.homeImage).width(900).auto('format').url()}
        srcset={`${urlFor(about.homeImage).width(600).auto('format').url()} 600w,
                 ${urlFor(about.homeImage).width(900).auto('format').url()} 900w,
                 ${urlFor(about.homeImage).width(1200).auto('format').url()} 1200w`}
        sizes="(max-width: 768px) 100vw, 50vw"
        alt={about.homeImage.altText || about?.artistName || ''}
        decoding="async"
      />
    )}
    <div class="intro">
      {about?.artistName && <h1>{about.artistName}</h1>}
      {about?.tagline && <p class="tagline">{about.tagline}</p>}
    </div>
  </main>
</Layout>
<style is:global>
  /* home page fits the viewport: footer sits at the bottom, no scrolling */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* outranks the layout's own .site-footer rule */
  body > .site-footer {
    margin-top: auto;
    padding: 24px 0;
  }
</style>
<style>
  .hero {
    text-align: center;
    padding-top: 16vh;
  }
  .hero.has-image {
    max-width: 1080px;
    width: 100%;
    margin: 0 auto;
    padding-top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }
  h1 {
    font-size: 21px;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #1e1e1e;
    margin: 0;
  }
  .tagline {
    max-width: 560px;
    margin: 22px auto 0;
    font-size: 15px;
    font-style: italic;
    color: #9a9a9a;
  }
  .hero-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 62.5%; /* 25% larger than the previous 50% */
    /* keeps the whole page inside one screen; shrinks with the window */
    max-height: calc((100vh - 300px) * 0.625);
    background-color: #f4f4f4;
  }
  @media (max-width: 768px) {
    .hero.has-image { gap: 28px; }
    .hero-image {
      max-width: 100%;
      max-height: 45vh;
    }
  }
</style>
