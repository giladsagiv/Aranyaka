---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/image';
import type { AboutPage } from '../sanity/types';

const about: AboutPage | null = await sanityClient.fetch(`
  *[_type == "aboutPage"][0] { artistName, tagline, homeImage }
`);
---
<Layout title={about?.artistName}>
  <main class:list={['hero', { 'has-image': !!about?.homeImage }]}>
    <div class="intro">
      {about?.artistName && <h1>{about.artistName}</h1>}
      {about?.tagline && <p class="tagline">{about.tagline}</p>}
    </div>
    {about?.homeImage && (
      <img
        class="side-image"
        src={urlFor(about.homeImage).width(900).auto('format').url()}
        srcset={`${urlFor(about.homeImage).width(600).auto('format').url()} 600w,
                 ${urlFor(about.homeImage).width(900).auto('format').url()} 900w,
                 ${urlFor(about.homeImage).width(1200).auto('format').url()} 1200w`}
        sizes="(max-width: 768px) 100vw, 42vw"
        alt={about.homeImage.altText || about?.artistName || ''}
        decoding="async"
      />
    )}
  </main>
</Layout>
<style is:global>
  /* home page fits the viewport: footer sits at the bottom, no scrolling */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* outranks the layout's own .site-footer rule */
  body > .site-footer {
    margin-top: auto;
    padding: 24px 0;
  }
</style>
<style>
  .hero {
    text-align: center;
    padding-top: 16vh;
  }
  .hero.has-image {
    max-width: 1080px;
    width: 100%;
    margin: 0 auto;
    padding-top: 0;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: start; /* name top-aligns with the image */
  }
  h1 {
    font-size: 29px;
    font-weight: 300;
    line-height: 1.15; /* trims leading so the name sits level with the image top */
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #1e1e1e;
    margin: 0;
  }
  .tagline {
    max-width: 560px;
    margin: 22px auto 0;
    font-size: 15px;
    font-style: italic;
    color: #9a9a9a;
  }
  .side-image {
    display: block;
    width: auto;
    height: auto;
    /* half size within its column; the column ratio itself is unchanged */
    max-width: 50%;
    /* keeps the whole page inside one screen; shrinks with the window */
    max-height: calc((100vh - 280px) / 2);
    justify-self: center;
    background-color: #f4f4f4;
  }
  @media (max-width: 768px) {
    .hero.has-image {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    /* stacked on phones, so the half-size rule above would leave it tiny */
    .side-image {
      max-width: 100%;
      max-height: 55vh;
    }
  }
</style>
