---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { useTranslations } from '../i18n/utils';
import type { AboutPage } from '../sanity/types';

const t = useTranslations();

const about: AboutPage | null = await sanityClient.fetch(`
  *[_type == "aboutPage"][0] {
    openingQuote, quoteAttribution, body,
    "cvUrl": cvFile.asset->url
  }
`);
const paragraphs = (about?.body || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Email is reused from the Contact page so the CV header carries no placeholder.
const cvEmail: string | null = await sanityClient.fetch(
  `*[_type == "contactPage"][0].email`
);

// Curriculum Vitae — fixed content, rendered as a two-column (years | details) list.
const cv = [
  {
    title: 'Education & Academic Background',
    entries: [
      {
        years: '2008 – 2012',
        role: 'B.Ed. F.A. in Fine Art & Art Education',
        org: 'The Faculty of Arts – HaMidrasha, Beit Berl College, Israel',
        note: 'Specialization in Plastic Arts (Sculpture, Installation, and Mixed Media).',
      },
    ],
  },
  {
    title: 'Traditional Practice & Apprenticeship',
    entries: [
      {
        years: '2011 – 2021',
        role: 'Shodō (Japanese Calligraphy), Sumi-e & Qi Gong Studies',
        org: 'Long-term mentorship and intensive practice under Sensei Kazuo Ishii',
        note: 'Deep study of traditional ink brushwork, meditative practice, and energy movement.',
      },
    ],
  },
  {
    title: 'Somatic & Movement Practice',
    entries: [
      {
        years: '2023 – Present',
        role: 'Advanced Vijnana Yoga Mentorship & Practitioner Program',
        org: 'In-depth, long-term study with Orit Sen-Gupta, founder of Vijnana Yoga',
        note: '',
      },
      {
        years: '2020 – 2021',
        role: 'Rehabilitative Yoga Teacher Training',
        org: 'Studied under Noga Barkai and Alphonse Traxel, Israel',
        note: 'Focus on adapting yoga practice for pain management and injury recovery, applying anatomy-informed somatic principles, and integrating Thai Yoga Therapy techniques.',
      },
      {
        years: '2016 – 2019',
        role: 'Senior Vijnana Yoga Teacher Certification',
        org: 'Wingate Institute, Israel',
        note: 'In-depth study of Meditation, Pranayama, Asana, and classical yoga texts, with an emphasis on establishing a personal daily practice (Sadhana) and teaching methodology.',
      },
      {
        years: '2012 – Present',
        role: 'Continuous Teacher Mentorship, Workshops & Retreats',
        org: 'Ongoing advanced studies and long-term mentorship under Noga Barkai',
        note: '',
      },
    ],
  },
  {
    title: 'Selected Exhibitions & Performances',
    entries: [
      {
        years: '2012',
        role: 'Graduation Exhibition, HaMidrasha Faculty of Arts, Beit Berl College',
        org: 'Featured Installation: Seahorse & Marionette (Mixed Media, Sculptural Installation, and Performance components).',
        note: '',
      },
    ],
  },
  {
    title: 'Collections',
    entries: [
      {
        years: '',
        role: 'Private collections in Israel and abroad.',
        org: '',
        note: '',
      },
    ],
  },
];
---
<Layout title={t('nav.about')}>
  <main class="about">
    {about?.openingQuote && (
      <blockquote class="epigraph">
        <p>{about.openingQuote}</p>
        {about.quoteAttribution && <cite>— {about.quoteAttribution}</cite>}
      </blockquote>
    )}
    {paragraphs.map((p) => <p>{p}</p>)}
    <section class="vitae">
      <h2 class="vitae__title">Curriculum Vitae</h2>
      <header class="vitae__id">
        <div class="vitae__name">{t('site.artist')}</div>
        <div class="vitae__bio">b. Israel | Israeli artist based in Portugal</div>
        <div class="vitae__links">
          <a href="https://www.shanisagiv.com" target="_blank" rel="noopener">www.shanisagiv.com</a>
          {cvEmail && (
            <>
              <span class="vitae__sep">·</span>
              <a href={`mailto:${cvEmail}`}>{cvEmail}</a>
            </>
          )}
        </div>
      </header>
      {cv.map((section) => (
        <div class="vitae__group">
          <h3 class="vitae__heading">{section.title}</h3>
          {section.entries.map((entry) => (
            <div class="vitae__entry">
              <div class="vitae__years">{entry.years}</div>
              <div class="vitae__detail">
                <div class="vitae__role">{entry.role}</div>
                {entry.org && <div class="vitae__org">{entry.org}</div>}
                {entry.note && <div class="vitae__note">{entry.note}</div>}
              </div>
            </div>
          ))}
        </div>
      ))}
    </section>
    {about?.cvUrl && (
      <p class="cv">
        <a href={about.cvUrl} target="_blank" rel="noopener" download>{t('about.cv')}</a>
      </p>
    )}
  </main>
</Layout>
<style>
  .about {
    max-width: 640px;
    margin: 24px auto 0;
  }
  .about p {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 18px;
    line-height: 2.05;
    color: #4f4f4f;
    margin: 0 0 1.6em;
  }
  .epigraph {
    margin: 0 0 2.4em;
    padding: 0;
    border: 0;
    text-align: center;
  }
  .epigraph p {
    font-style: italic;
    font-size: 22px;
    line-height: 1.6;
    color: #3d3d3d;
    margin: 0;
  }
  .epigraph cite {
    display: block;
    margin-top: 0.8em;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-style: normal;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: #8a8a8a;
  }
  .about .cv {
    text-align: center;
    margin: 4em 0 0;
  }
  .cv a {
    display: inline-block;
    padding: 12px 26px;
    border: 1px solid #1e1e1e;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1e1e1e;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .cv a:hover {
    background-color: #1e1e1e;
    color: #ffffff;
  }
  .vitae {
    margin-top: 3.2em;
    padding-top: 2.8em;
    border-top: 1px solid #e6e6e6;
  }
  .vitae__title {
    margin: 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1e1e1e;
    text-align: center;
  }
  .vitae__id {
    text-align: center;
    margin: 1.2em 0 2.8em;
  }
  .vitae__name {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 20px;
    letter-spacing: 0.02em;
    color: #3d3d3d;
  }
  .vitae__bio {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-style: italic;
    font-size: 16px;
    color: #6a6a6a;
    margin-top: 0.2em;
  }
  .vitae__links {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: #8a8a8a;
    margin-top: 0.7em;
  }
  .vitae__links a {
    color: #1e1e1e;
    text-decoration: none;
    border-bottom: 1px solid #d8d8d8;
    padding-bottom: 1px;
    transition: border-color 0.15s ease;
  }
  .vitae__links a:hover { border-bottom-color: #1e1e1e; }
  .vitae__sep { margin: 0 0.5em; color: #cfcfcf; }
  .vitae__group { margin-top: 2.4em; }
  .vitae__heading {
    margin: 0 0 1.2em;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a9a9a;
    padding-bottom: 0.7em;
    border-bottom: 1px solid #eee;
  }
  .vitae__entry {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    margin-bottom: 1.6em;
  }
  .vitae__entry:last-child { margin-bottom: 0; }
  .vitae__years {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: #9a9a9a;
    line-height: 1.6;
    padding-top: 0.15em;
  }
  .vitae__role {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    color: #3d3d3d;
  }
  .vitae__org {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.55;
    color: #565656;
    margin-top: 0.2em;
  }
  .vitae__note {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-style: italic;
    font-size: 16px;
    line-height: 1.55;
    color: #7a7a7a;
    margin-top: 0.35em;
  }
  @media (max-width: 560px) {
    .vitae__entry {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .vitae__years { padding-top: 0; }
  }
</style>
