---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../utils/image';
import { toEmbedUrl } from '../../utils/video';
import { useTranslations } from '../../i18n/utils';
import { defaultLang } from '../../i18n/ui';
import type { Post } from '../../sanity/types';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<Post[]>(`
    *[_type == "post" && defined(slug.current)] {
      title, publishedAt, videoUrl, coverImage, body, galleryLinkText,
      "slug": slug.current,
      galleryLink->{ _type, _id, title, "slug": slug.current }
    }
  `);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const t = useTranslations();
const { post } = Astro.props;

const paragraphs = (post.body || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const embedUrl = toEmbedUrl(post.videoUrl);
const date = new Date(post.publishedAt).toLocaleDateString(defaultLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// optional link back into the gallery — an artwork page, or the gallery
// pre-filtered to a category
const gl = post.galleryLink;
let galleryHref: string | null = null;
let defaultLabel: string | null = null;
if (gl?._type === 'artwork' && gl.slug) {
  galleryHref = `/artwork/${gl.slug}`;
  defaultLabel = `View “${gl.title}” in the Gallery →`;
} else if (gl?._type === 'category') {
  galleryHref = `/gallery?category=${gl._id}`;
  defaultLabel = `Explore ${gl.title} in the Gallery →`;
}

// the label can be a custom sentence with the clickable words wrapped in
// [[ ]] — split it into the text before the link, the link itself, and the
// text after. With no custom text (or no [[ ]] marker) the whole label links.
let linkBefore = '';
let linkText: string | null = defaultLabel;
let linkAfter = '';
const custom = post.galleryLinkText?.trim();
if (custom) {
  const marker = custom.match(/^([\s\S]*?)\[\[([\s\S]+?)\]\]([\s\S]*)$/);
  if (marker) {
    linkBefore = marker[1];
    linkText = marker[2];
    linkAfter = marker[3];
  } else {
    linkText = custom;
  }
}
---
<Layout title={post.title}>
  <main class="post">
    <a href="/journal" class="back">{t('journal.back')}</a>
    <p class="date">{date}</p>
    <h1>{post.title}</h1>

    {embedUrl && (
      <div class="video">
        <iframe
          src={embedUrl}
          title={post.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {!embedUrl && post.videoUrl && (
      <p class="video-link">
        <a href={post.videoUrl} target="_blank" rel="noopener noreferrer">
          {t('journal.watch')}
        </a>
      </p>
    )}

    {post.coverImage && !embedUrl && (
      <img
        class="cover"
        src={urlFor(post.coverImage).width(1400).auto('format').url()}
        alt={post.coverImage.altText || post.title}
        decoding="async"
      />
    )}

    {paragraphs.map((p) => <p class="body">{p}</p>)}

    {galleryHref && (
      <p class="gallery-link">
        {linkBefore}<a href={galleryHref}>{linkText}</a>{linkAfter}
      </p>
    )}
  </main>
</Layout>
<style>
  .post { max-width: 720px; margin: 0 auto; }
  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    color: #696969;
    text-decoration: none;
  }
  .back:hover { color: #1e1e1e; }
  .date {
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #9a9a9a;
    margin: 0 0 8px;
  }
  h1 {
    font-size: 24px;
    font-weight: 400;
    color: #1e1e1e;
    text-align: center;
    margin: 0 0 32px;
  }
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 36px;
    background-color: #f4f4f4;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-link { text-align: center; margin: 0 0 32px; }
  .video-link a { color: #1e1e1e; }
  .cover {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 36px;
    background-color: #f4f4f4;
  }
  .body {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 18px;
    line-height: 2.05;
    color: #4f4f4f;
    margin: 0 0 1.6em;
  }
  .gallery-link {
    text-align: center;
    margin: 40px 0 0;
    font-size: 13px;
    letter-spacing: 0.07em;
    color: #696969;
  }
  .gallery-link a {
    color: #1e1e1e;
    text-decoration: none;
    border-bottom: 1px solid #d8d8d8;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .gallery-link a:hover { border-bottom-color: #1e1e1e; }
</style>
