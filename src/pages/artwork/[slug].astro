---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../utils/image';
import { useTranslations } from '../../i18n/utils';
import type { Artwork } from '../../sanity/types';

export async function getStaticPaths() {
  const artworks = await sanityClient.fetch<Artwork[]>(`
    *[_type == "artwork" && defined(slug.current)] {
      title, image, altText, dimensions, year, medium, price, sold,
      description, "extraImages": extraImages[defined(asset)], provenance, printsAvailable,
      "slug": slug.current, "categoryId": category._ref,
      "journalSlug": journalPost->slug.current
    }
  `);
  return artworks.map((art) => ({
    params: { slug: art.slug },
    props: { art },
  }));
}

const t = useTranslations();
const { art } = Astro.props;

const meta = [art.medium, art.year, art.dimensions].filter(Boolean).join(' · ');
const priceLine = art.sold ? t('artwork.sold') : art.price;
// return to the collection this piece belongs to, not the default one
const backHref = art.categoryId ? `/gallery?category=${art.categoryId}` : '/gallery';
---
<Layout title={`${art.title} · ${t('site.title')}`}>
  <main class="container">
    <a href={backHref} class="back">{t('artwork.back')}</a>
    <img
      src={urlFor(art.image).width(1400).auto('format').url()}
      alt={art.altText}
      decoding="async"
    />
    <div class="info">
      <h1>{art.title}</h1>
      {meta && <p class="meta">{meta}</p>}
      {priceLine && <p class="price">{priceLine}</p>}
      {art.provenance && <p class="provenance">{art.provenance}</p>}
      {art.printsAvailable && <p class="prints">Fine Art Prints available</p>}
      {art.description && <p class="desc">{art.description}</p>}
      {art.journalSlug && (
        <p class="journal-link">
          <a href={`/journal/${art.journalSlug}`}>Read the story behind this piece in the Journal →</a>
        </p>
      )}
    </div>
    {art.extraImages && art.extraImages.length > 0 && (
      <div class="extra">
        {art.extraImages.map((img) => (
          <img
            src={urlFor(img).width(1400).auto('format').url()}
            alt={img.altText || art.altText}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )}
  </main>
</Layout>
<style>
  .container { max-width: 900px; margin: 0 auto; }
  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    color: #696969;
    text-decoration: none;
  }
  .back:hover { color: #1e1e1e; }
  img { width: 100%; height: auto; display: block; background-color: #f4f4f4; }
  .info { text-align: center; margin-top: 28px; }
  h1 {
    font-size: 21px;
    font-weight: 400;
    color: #1e1e1e;
    margin: 0 0 6px;
  }
  .meta { font-size: 14px; margin: 0 0 4px; }
  .price { font-size: 14px; color: #1e1e1e; margin: 0; }
  .provenance { font-size: 14px; color: #696969; margin: 6px 0 0; }
  .prints {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #1e1e1e;
    margin: 8px 0 0;
  }
  .journal-link { margin: 28px 0 0; }
  .journal-link a {
    font-size: 13px;
    letter-spacing: 0.07em;
    color: #1e1e1e;
    text-decoration: none;
    border-bottom: 1px solid #d8d8d8;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .journal-link a:hover { border-bottom-color: #1e1e1e; }
  .desc {
    max-width: 620px;
    margin: 24px auto 0;
    text-align: left;
    line-height: 1.9;
  }
  .extra {
    display: grid;
    gap: 32px;
    margin-top: 48px;
  }
</style>
