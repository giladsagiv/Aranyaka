---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../utils/image';
import { useTranslations } from '../../i18n/utils';
import type { Artwork } from '../../sanity/types';

export async function getStaticPaths() {
  const artworks = await sanityClient.fetch<Artwork[]>(`
    *[_type == "artwork" && defined(slug.current)] {
      title, image, altText, dimensions, year, medium, price, sold,
      description, "extraImages": extraImages[defined(asset)], provenance, printsAvailable,
      "slug": slug.current, "categoryId": category._ref,
      "journalSlug": journalPost->slug.current
    }
  `);
  return artworks.map((art) => ({
    params: { slug: art.slug },
    props: { art },
  }));
}

const t = useTranslations();
const { art } = Astro.props;

const meta = [art.medium, art.year, art.dimensions].filter(Boolean).join(' · ');
const priceLine = art.sold ? t('artwork.sold') : art.price;
// return to the collection this piece belongs to, not the default one
const backHref = art.categoryId ? `/gallery?category=${art.categoryId}` : '/gallery';
// Single-image pieces are sized to fit one screen (no scroll). Pieces with
// extra images below scroll naturally, so they opt out of the fit-to-viewport.
const hasExtra = Boolean(art.extraImages && art.extraImages.length > 0);
---
<Layout title={`${art.title} · ${t('site.title')}`}>
  <main class:list={['container', 'artwork-page', { single: !hasExtra }]}>
    <a href={backHref} class="back">{t('artwork.back')}</a>
    <div class="stage">
      <img
        src={urlFor(art.image).width(1400).auto('format').url()}
        alt={art.altText}
        decoding="async"
      />
    </div>
    <div class="info">
      <h1>{art.title}</h1>
      {meta && <p class="meta">{meta}</p>}
      {priceLine && <p class="price">{priceLine}</p>}
      {art.provenance && <p class="provenance">{art.provenance}</p>}
      {art.printsAvailable && <p class="prints">Fine Art Prints available</p>}
      {art.description && <p class="desc">{art.description}</p>}
      {art.journalSlug && (
        <p class="journal-link">
          <a href={`/journal/${art.journalSlug}`}>Read the story behind this piece in the Journal →</a>
        </p>
      )}
    </div>
    {art.extraImages && art.extraImages.length > 0 && (
      <div class="extra">
        {art.extraImages.map((img) => (
          <img
            src={urlFor(img).width(1400).auto('format').url()}
            alt={img.altText || art.altText}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )}
  </main>
</Layout>
<style>
  .container { max-width: 900px; margin: 0 auto; }
  /* Single-image pieces: make the whole viewport a flex column so the artwork
     fills exactly the space left over by the header, back link, caption and
     footer. This has no fixed "magic number" to subtract, so it fits on any
     viewport height — including tall ones like an iPad where a hardcoded
     offset left the footer overflowing below the fold. */
  :global(body:has(.artwork-page.single)) {
    display: flex;
    flex-direction: column;
    height: 100dvh; /* definite height so the stage can shrink to fit within it */
  }
  .artwork-page.single {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0; /* allow the stage below to shrink instead of overflowing */
  }
  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    color: #696969;
    text-decoration: none;
  }
  .back:hover { color: #1e1e1e; }
  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* The stage absorbs the leftover height (flex-basis 0 so it takes only what
     is left, not the image's natural size); the image scales to fit inside it,
     so tall/portrait pieces never push the page taller. */
  .artwork-page.single .stage {
    flex: 1;
    min-height: 0;
  }
  .stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    background-color: #f4f4f4;
  }
  /* Multi-image pieces scroll, so cap the lead image near one screen instead. */
  .artwork-page:not(.single) .stage img { max-height: 80dvh; }
  .info { text-align: center; margin-top: 28px; flex: 0 0 auto; }
  h1 {
    font-size: 21px;
    font-weight: 400;
    color: #1e1e1e;
    margin: 0 0 6px;
  }
  .meta { font-size: 14px; margin: 0 0 4px; }
  .price { font-size: 14px; color: #1e1e1e; margin: 0; }
  .provenance { font-size: 14px; color: #696969; margin: 6px 0 0; }
  .prints {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #1e1e1e;
    margin: 8px 0 0;
  }
  .journal-link { margin: 28px 0 0; }
  .journal-link a {
    font-size: 13px;
    letter-spacing: 0.07em;
    color: #1e1e1e;
    text-decoration: none;
    border-bottom: 1px solid #d8d8d8;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .journal-link a:hover { border-bottom-color: #1e1e1e; }
  .desc {
    max-width: 620px;
    margin: 24px auto 0;
    text-align: left;
    line-height: 1.9;
  }
  .extra {
    display: grid;
    gap: 32px;
    margin-top: 48px;
  }
</style>
