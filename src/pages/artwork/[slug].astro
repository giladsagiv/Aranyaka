---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../utils/image';
import { useTranslations } from '../../i18n/utils';
import type { Artwork } from '../../sanity/types';

export async function getStaticPaths() {
  const artworks = await sanityClient.fetch<Artwork[]>(`
    *[_type == "artwork" && defined(slug.current)] {
      title, image, altText, year, medium, description,
      "slug": slug.current
    }
  `);
  return artworks.map((art) => ({
    params: { slug: art.slug },
    props: { art },
  }));
}

const t = useTranslations();
const { art } = Astro.props;
---
<Layout title={art.title}>
  <main class="container">
    <div>
      <a href="/" class="back">{t('artwork.back')}</a>
      <img
        src={urlFor(art.image).width(1200).auto('format').url()}
        alt={art.altText}
        decoding="async"
      />
    </div>
    <div class="info">
      <h1>{art.title}</h1>
      <p class="meta">{art.medium}{art.year ? `, ${art.year}` : ''}</p>
      {art.description && <p class="desc">{art.description}</p>}
    </div>
  </main>
</Layout>
<style>
  .container {
    max-width: 1000px; margin: 0 auto;
    display: grid; grid-template-columns: 3fr 2fr; gap: 60px;
  }
  @media (max-width: 768px) {
    .container { grid-template-columns: 1fr; gap: 30px; }
  }
  .back { display: inline-block; margin-bottom: 30px; color: inherit;
          text-decoration: none; font-size: 0.9rem; }
  img { width: 100%; height: auto; background-color: #eae6e0; }
  h1 { font-weight: 300; font-size: 2rem; margin: 0 0 10px; }
  .meta { color: #6e6963; margin-bottom: 20px; }
  .desc { font-size: 1.05rem; line-height: 1.7; }
</style>
