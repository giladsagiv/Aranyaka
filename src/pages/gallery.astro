---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/image';
import { useTranslations } from '../i18n/utils';
import type { Artwork, Category } from '../sanity/types';

const t = useTranslations();

// category drag-order = filter button order
const categories: Category[] = await sanityClient.fetch(`
  *[_type == "category"] | order(orderRank) {
    _id, title, isDefault, seriesTitle, seriesSubtitle, statement
  }
`);

// the gallery always has one category selected: the one marked default,
// otherwise the first in drag order. null only when no categories exist.
const activeFilter =
  categories.find((cat) => cat.isDefault)?._id ?? categories[0]?._id ?? null;

// one flat grid in the global artwork drag-order
const artworks: Artwork[] = await sanityClient.fetch(`
  *[_type == "artwork"] | order(orderRank) {
    title, image, altText, medium, provenance, printsAvailable,
    "slug": slug.current, "categoryId": category._ref,
    "journalSlug": journalPost->slug.current
  }
`);

// per-category series header shown above the grid; swaps with the active filter
const seriesHeaders = categories
  .filter((cat) => cat.seriesTitle || cat.statement)
  .map((cat) => ({
    id: cat._id,
    title: cat.seriesTitle,
    subtitle: cat.seriesSubtitle,
    statement: (cat.statement || '')
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .filter(Boolean),
  }));
---
<Layout title={t('nav.gallery')}>
  <main>
    <script is:inline define:vars={{ ids: categories.map((c) => c._id) }}>
      // Pre-paint: when deep-linked to /gallery?category=<id>, hide the other
      // collections before first paint so the default one never flashes. The
      // interactive script below re-applies the filter and drops this style.
      (function () {
        const requested = new URLSearchParams(location.search).get('category');
        if (!requested || !ids.includes(requested)) return;
        const style = document.createElement('style');
        style.id = 'pre-filter';
        style.textContent =
          '.card:not([data-category="' + requested + '"]),' +
          '.series:not([data-series="' + requested + '"]){display:none!important}' +
          '.card[data-category="' + requested + '"],' +
          '.series[data-series="' + requested + '"]{display:block!important}' +
          '.filter-btn[data-filter="' + requested + '"]{opacity:1!important}' +
          '.filter-btn[aria-pressed="true"]:not([data-filter="' + requested + '"]){opacity:.4!important}';
        document.head.appendChild(style);
      })();
    </script>
    {categories.length > 0 && (
      <nav class="filter-nav" aria-label="Category filter">
        {categories.map((cat, i) => (
          <>
            {i > 0 && <span class="separator" aria-hidden="true">/</span>}
            <button
              class="filter-btn"
              data-filter={cat._id}
              aria-pressed={activeFilter === cat._id ? 'true' : 'false'}
            >
              {cat.title}
            </button>
          </>
        ))}
      </nav>
    )}

    {seriesHeaders.map((s) => (
      <header
        class="series"
        data-series={s.id}
        style={activeFilter && s.id !== activeFilter ? 'display: none' : undefined}
      >
        {s.title && <h1 class="series__title">{s.title}</h1>}
        {s.subtitle && <p class="series__subtitle">{s.subtitle}</p>}
        {s.statement.length > 0 && (
          <div class="series__statement">
            {s.statement.map((p) => <p>{p}</p>)}
          </div>
        )}
      </header>
    ))}

    <div class="gallery-grid">
      {artworks.map((art) => {
        const base = urlFor(art.image).auto('format');
        return (
          <article
            class="card"
            data-category={art.categoryId}
            style={activeFilter && art.categoryId !== activeFilter
              ? 'display: none'
              : undefined}
          >
            <div class="card__frame">
              <a class="card__media" href={`/artwork/${art.slug}`}>
                <img
                  src={base.width(600).url()}
                  srcset={`${base.width(400).url()} 400w,
                           ${base.width(600).url()} 600w,
                           ${base.width(800).url()} 800w`}
                  sizes="(max-width: 640px) 100vw,
                         (max-width: 1024px) 50vw, 33vw"
                  alt={art.altText}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="card__overlay">
                <p class="card__title">{art.title}</p>
                {art.medium && <p class="card__line">{art.medium}</p>}
                {art.provenance && <p class="card__line">{art.provenance}</p>}
                {art.printsAvailable && (
                  <p class="card__line card__prints">Fine Art Prints available</p>
                )}
                {art.journalSlug && (
                  <a class="card__journal" href={`/journal/${art.journalSlug}`}>
                    Read the story behind this piece in the Journal →
                  </a>
                )}
              </div>
            </div>
            <p class="card__caption">{art.title}</p>
          </article>
        );
      })}
    </div>
  </main>
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.gallery-grid .card');
  const headers = document.querySelectorAll<HTMLElement>('.series');

  function applyFilter(filter: string | undefined) {
    buttons.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.filter === filter))
    );
    cards.forEach((card) => {
      card.style.display = card.dataset.category === filter ? '' : 'none';
    });
    headers.forEach((h) => {
      h.style.display = h.dataset.series === filter ? '' : 'none';
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter));
  });

  // deep-link: /gallery?category=<id> opens pre-filtered to that category
  const requested = new URLSearchParams(location.search).get('category');
  if (requested && [...buttons].some((b) => b.dataset.filter === requested)) {
    applyFilter(requested);
  }
  // the pre-paint style (see inline script) has done its job; drop it so its
  // !important rules can't override interactive filtering on later clicks
  document.getElementById('pre-filter')?.remove();
</script>
<style>
  main { max-width: 1080px; margin: 0 auto; }
  .filter-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0 0 44px;
  }
  .filter-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    color: #1a1a1a;
    opacity: 0.4; /* non-active links are muted */
    transition: opacity 0.2s ease;
  }
  .filter-btn:hover,
  .filter-btn[aria-pressed='true'] {
    opacity: 1;
  }
  .separator {
    font-size: 0.85rem;
    color: #1a1a1a;
    opacity: 0.2;
    user-select: none;
  }
  /* per-category series header */
  .series {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 60px;
  }
  .series__title {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: clamp(29px, 5vw, 44px);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: 0.01em;
    color: #1e1e1e;
    margin: 0;
  }
  .series__subtitle {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin: 14px 0 0;
  }
  .series__statement {
    max-width: 560px;
    margin: 30px auto 0;
  }
  .series__statement p {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
    letter-spacing: 0.02em;
    color: #5a5a5a;
    margin: 0 0 1em;
  }
  .series__statement p:last-child { margin-bottom: 0; }
  /* grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 36px 20px;
  }
  .card { color: inherit; }
  .card__frame { position: relative; }
  .card__media { display: block; text-decoration: none; }
  .card__media img {
    width: 100%;
    height: auto; /* natural proportions; show the whole artwork uncropped */
    display: block;
    background-color: #f4f4f4;
  }
  /* catalog spec: revealed over the image on hover/focus (desktop) */
  .card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 24px;
    text-align: center;
    background-color: rgba(250, 249, 247, 0.93);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none; /* clicks fall through to the image link beneath */
  }
  .card__frame:hover .card__overlay,
  .card__frame:focus-within .card__overlay {
    opacity: 1;
  }
  .card__title {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 23px;
    line-height: 1.2;
    color: #1e1e1e;
    margin: 0 0 4px;
  }
  .card__line {
    font-size: 12.5px;
    font-weight: 300;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: #555;
    margin: 0;
  }
  .card__prints { color: #1e1e1e; }
  .card__journal {
    pointer-events: none; /* only clickable once the overlay is revealed */
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.07em;
    color: #1e1e1e;
    text-decoration: none;
    border-bottom: 1px solid #cfcac2;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .card__frame:hover .card__journal,
  .card__frame:focus-within .card__journal { pointer-events: auto; }
  .card__journal:hover { border-bottom-color: #1e1e1e; }
  .card__caption {
    display: none; /* desktop: the title lives in the hover overlay */
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #696969;
    text-align: center;
    margin: 10px 0 0;
  }
  /* touch / narrow screens have no hover: show a caption, tap opens the page */
  @media (max-width: 640px) {
    .card__overlay { display: none; }
    .card__caption { display: block; }
  }
</style>
