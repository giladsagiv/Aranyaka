---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/image';
import { useTranslations } from '../i18n/utils';
import type { Artwork, Category } from '../sanity/types';

const t = useTranslations();

// category drag-order = filter button order
const categories: Category[] = await sanityClient.fetch(`
  *[_type == "category"] | order(orderRank) {
    _id, title, isDefault, seriesTitle, seriesSubtitle, statement
  }
`);

// the gallery always has one category selected: the one marked default,
// otherwise the first in drag order. null only when no categories exist.
const activeFilter =
  categories.find((cat) => cat.isDefault)?._id ?? categories[0]?._id ?? null;

// one flat grid in the global artwork drag-order. aspectRatio (width/height)
// drives the justified layout below.
const artworks: (Artwork & { aspect?: number })[] = await sanityClient.fetch(`
  *[_type == "artwork" && hideFromGallery != true] | order(orderRank) {
    title, image, altText, medium, provenance, printsAvailable,
    "slug": slug.current, "categoryId": category._ref,
    "aspect": image.asset->metadata.dimensions.aspectRatio
  }
`);

// Justified rows (Flickr / Google-Photos style): each row is scaled to one
// width, so every piece in a row shares a single height and the row fills its
// width edge-to-edge — no crop, no gaps, whatever the mix of orientations. Row
// membership is decided here from each image's aspect ratio; flexbox then
// re-justifies each row to the real screen width with no client JS.
const TARGET_H = 280; // desired row height (px) at the reference width
const GAP = 16; // gap between pieces in a row (px)
const REF_W = 1080; // reference container width the rows are packed against

type RowItem = Artwork & { aspect?: number; a: number };
type Row = { items: RowItem[]; last: boolean };
function justifiedRows(items: (Artwork & { aspect?: number })[]): Row[] {
  const rows: Row[] = [];
  let cur: RowItem[] = [];
  let aspectSum = 0;
  for (const it of items) {
    const a = typeof it.aspect === 'number' && it.aspect > 0 ? it.aspect : 1;
    cur.push({ ...it, a });
    aspectSum += a;
    // the width this row would occupy laid out at the target height
    const rowW = aspectSum * TARGET_H + GAP * (cur.length - 1);
    if (rowW >= REF_W) {
      rows.push({ items: cur, last: false });
      cur = [];
      aspectSum = 0;
    }
  }
  if (cur.length) rows.push({ items: cur, last: true });
  return rows;
}

// group the flat drag-ordered list by category; the gallery shows one at a time
const galleryCats = categories.map((cat) => ({
  cat,
  rows: justifiedRows(artworks.filter((art) => art.categoryId === cat._id)),
  statement: (cat.statement || '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean),
}));
---
<Layout title={t('nav.gallery')}>
  <main>
    <script is:inline define:vars={{ ids: categories.map((c) => c._id) }}>
      // Pre-paint: when deep-linked to /gallery?category=<id>, hide the other
      // collections before first paint so the default one never flashes. The
      // interactive script below re-applies the filter and drops this style.
      (function () {
        const requested = new URLSearchParams(location.search).get('category');
        if (!requested || !ids.includes(requested)) return;
        const style = document.createElement('style');
        style.id = 'pre-filter';
        style.textContent =
          '.cat:not([data-category="' + requested + '"]){display:none!important}' +
          '.cat[data-category="' + requested + '"]{display:block!important}' +
          '.filter-btn[data-filter="' + requested + '"]{opacity:1!important}' +
          '.filter-btn[aria-pressed="true"]:not([data-filter="' + requested + '"]){opacity:.4!important}';
        document.head.appendChild(style);
      })();
    </script>
    {categories.length > 0 && (
      <nav class="filter-nav" aria-label="Category filter">
        {categories.map((cat, i) => (
          <>
            {i > 0 && <span class="separator" aria-hidden="true">/</span>}
            <button
              class="filter-btn"
              data-filter={cat._id}
              aria-pressed={activeFilter === cat._id ? 'true' : 'false'}
            >
              {cat.title}
            </button>
          </>
        ))}
      </nav>
    )}

    {galleryCats.map(({ cat, rows, statement }) => (
      <section
        class="cat"
        data-category={cat._id}
        style={activeFilter && cat._id !== activeFilter ? 'display: none' : undefined}
      >
        {(cat.seriesTitle || statement.length > 0) && (
          <header class="series">
            {cat.seriesTitle && <h1 class="series__title">{cat.seriesTitle}</h1>}
            {cat.seriesSubtitle && <p class="series__subtitle">{cat.seriesSubtitle}</p>}
            {statement.length > 0 && (
              <div class="series__statement">
                {statement.map((p) => <p>{p}</p>)}
              </div>
            )}
          </header>
        )}
        <div class="gallery">
          {rows.map((row) => (
            <div class:list={['jrow', { 'jrow--last': row.last }]}>
              {row.items.map((art) => {
                const base = urlFor(art.image).auto('format');
                return (
                  <a class="jitem" style={`--a: ${art.a}`} href={`/artwork/${art.slug}`}>
                    <img
                      src={base.width(800).url()}
                      srcset={`${base.width(400).url()} 400w,
                               ${base.width(600).url()} 600w,
                               ${base.width(900).url()} 900w`}
                      sizes="(max-width: 640px) 100vw, 45vw"
                      alt={art.altText}
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="card__overlay">
                      <p class="card__title">{art.title}</p>
                      {art.medium && <p class="card__line">{art.medium}</p>}
                      {art.provenance && <p class="card__line">{art.provenance}</p>}
                      {art.printsAvailable && (
                        <p class="card__line card__prints">Fine Art Prints available</p>
                      )}
                    </div>
                    <p class="card__caption">{art.title}</p>
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const sections = document.querySelectorAll<HTMLElement>('.cat');

  function applyFilter(filter: string | undefined) {
    buttons.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.filter === filter))
    );
    sections.forEach((s) => {
      s.style.display = s.dataset.category === filter ? '' : 'none';
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter));
  });

  // deep-link: /gallery?category=<id> opens pre-filtered to that category
  const requested = new URLSearchParams(location.search).get('category');
  if (requested && [...buttons].some((b) => b.dataset.filter === requested)) {
    applyFilter(requested);
  }
  // the pre-paint style (see inline script) has done its job; drop it so its
  // !important rules can't override interactive filtering on later clicks
  document.getElementById('pre-filter')?.remove();
</script>
<style>
  main { max-width: 1080px; margin: 0 auto; }
  .filter-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0 0 44px;
  }
  .filter-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    color: #1a1a1a;
    opacity: 0.4; /* non-active links are muted */
    transition: opacity 0.2s ease;
  }
  .filter-btn:hover,
  .filter-btn[aria-pressed='true'] {
    opacity: 1;
  }
  .separator {
    font-size: 0.85rem;
    color: #1a1a1a;
    opacity: 0.2;
    user-select: none;
  }
  /* per-category series header */
  .series {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 60px;
  }
  .series__title {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: clamp(29px, 5vw, 44px);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: 0.01em;
    color: #1e1e1e;
    margin: 0;
  }
  .series__subtitle {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin: 14px 0 0;
  }
  .series__statement {
    max-width: 560px;
    margin: 30px auto 0;
  }
  .series__statement p {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
    letter-spacing: 0.02em;
    color: #5a5a5a;
    margin: 0 0 1em;
  }
  .series__statement p:last-child { margin-bottom: 0; }
  /* justified gallery: rows of one shared height, filled edge-to-edge */
  .jrow {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }
  .jrow:last-child { margin-bottom: 0; }
  /* each piece grows in proportion to its aspect ratio (--a), so every piece in
     the row resolves to the same height and the row fills the full width — the
     whole artwork shows, uncropped and undistorted */
  .jitem {
    position: relative;
    flex-grow: var(--a);
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: #f4f3f0; /* placeholder while the image loads */
  }
  .jitem img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* a short final row sits at the target height, left-aligned, rather than being
     stretched full-width (which would blow up its one or two pieces) */
  .jrow--last { justify-content: flex-start; }
  /* its items are sized by the item box, not the img, so the hover overlay —
     which is pinned to that box — still covers the whole piece */
  .jrow--last .jitem { flex-grow: 0; flex-basis: calc(var(--a) * 280px); }
  /* catalog spec: revealed over the image on hover/focus (desktop) */
  .card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 24px;
    text-align: center;
    background-color: rgba(250, 249, 247, 0.93);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none; /* clicks fall through to the image link beneath */
  }
  .jitem:hover .card__overlay,
  .jitem:focus-within .card__overlay {
    opacity: 1;
  }
  .card__title {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 23px;
    line-height: 1.2;
    color: #1e1e1e;
    margin: 0 0 4px;
  }
  .card__line {
    font-size: 12.5px;
    font-weight: 300;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: #555;
    margin: 0;
  }
  .card__prints { color: #1e1e1e; }
  .card__caption {
    display: none; /* desktop: the title lives in the hover overlay */
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #696969;
    text-align: center;
    margin: 10px 0 0;
  }
  /* touch / narrow screens have no hover: stack full-width, show a caption */
  @media (max-width: 640px) {
    .jrow, .jrow--last {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }
    .jitem { flex-grow: 0; flex-basis: auto; width: 100%; }
    .card__overlay { display: none; }
    .card__caption { display: block; }
  }
</style>
