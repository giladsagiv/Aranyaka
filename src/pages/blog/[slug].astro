---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../utils/image';
import { toEmbedUrl } from '../../utils/video';
import { useTranslations } from '../../i18n/utils';
import { defaultLang } from '../../i18n/ui';
import type { Post } from '../../sanity/types';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<Post[]>(`
    *[_type == "post" && defined(slug.current)] {
      title, publishedAt, videoUrl, coverImage, body,
      "slug": slug.current
    }
  `);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const t = useTranslations();
const { post } = Astro.props;

const paragraphs = (post.body || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const embedUrl = toEmbedUrl(post.videoUrl);
const date = new Date(post.publishedAt).toLocaleDateString(defaultLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Layout title={post.title}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />
  <main class="post">
    <a href="/blog" class="back">{t('blog.back')}</a>
    <p class="date">{date}</p>
    <h1>{post.title}</h1>

    {embedUrl && (
      <div class="video">
        <iframe
          src={embedUrl}
          title={post.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {!embedUrl && post.videoUrl && (
      <p class="video-link">
        <a href={post.videoUrl} target="_blank" rel="noopener noreferrer">
          {t('blog.watch')}
        </a>
      </p>
    )}

    {post.coverImage && !embedUrl && (
      <img
        class="cover"
        src={urlFor(post.coverImage).width(1400).auto('format').url()}
        alt={post.coverImage.altText || post.title}
        decoding="async"
      />
    )}

    {paragraphs.map((p) => <p class="body">{p}</p>)}
  </main>
</Layout>
<style>
  .post { max-width: 720px; margin: 0 auto; }
  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    color: #696969;
    text-decoration: none;
  }
  .back:hover { color: #1e1e1e; }
  .date {
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #9a9a9a;
    margin: 0 0 8px;
  }
  h1 {
    font-size: 24px;
    font-weight: 400;
    color: #1e1e1e;
    text-align: center;
    margin: 0 0 32px;
  }
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 36px;
    background-color: #f4f4f4;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-link { text-align: center; margin: 0 0 32px; }
  .video-link a { color: #1e1e1e; }
  .cover {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 36px;
    background-color: #f4f4f4;
  }
  .body {
    font-family: 'EB Garamond', Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 2.05;
    color: #4f4f4f;
    margin: 0 0 1.6em;
  }
</style>
